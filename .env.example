# ---------------------------------------------------------------------------
# WIDRIVE — variables d'environnement (Expo)
# Copie ce fichier vers `.env` (ignoré par Git), remplace les valeurs, puis
# redémarre avec `npx expo start -c` : Expo inline les EXPO_PUBLIC_* au build.
#
# Valeurs PUBLIQUES uniquement (visibles dans le bundle). Ne mets JAMAIS ici la
# clé service_role / secret (`sb_secret_...`), ni aucun mot de passe ou PIN.
# Où les trouver : dashboard Supabase > Connect (onglet mobile) ou Settings > API Keys.
# Sans ces variables : l'écran Véhicules utilise les données locales en développement
# (__DEV__) et affiche une erreur en production.
# ---------------------------------------------------------------------------

# URL du projet Supabase (développement et production = deux projets distincts).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publishable (protégée par la RLS).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
